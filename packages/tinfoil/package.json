{
  "name": "tinfoil",
  "version": "2.0.0-rc.1",
  "description": "Tinfoil secure OpenAI client wrapper",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "browser": {
    "./dist/index.js": "./dist/index.browser.js",
    "./dist/internal/cachesecret-store.js": "./dist/internal/cachesecret-store.browser.js",
    "./dist/internal/platform.js": "./dist/internal/platform.browser.js",
    "./dist/internal/transport/tls.js": "./dist/internal/transport/tls.browser.js",
    "./dist/realtime.js": "./dist/realtime.browser.js",
    "./dist/internal/transport/ws.js": "./dist/internal/transport/ws.browser.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js",
      "default": "./dist/http.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "import": "./dist/ai-sdk.js",
      "default": "./dist/ai-sdk.js"
    },
    "./unsafe": {
      "types": "./dist/unsafe.d.ts",
      "import": "./dist/unsafe.js",
      "default": "./dist/unsafe.js"
    }
  },
  "scripts": {
    "build": "node scripts/generate-version.mjs && tsc && node ../../scripts/prune-declarations.mjs dist dist/index.d.ts dist/index.browser.d.ts dist/http.d.ts dist/ai-sdk.d.ts dist/unsafe.d.ts",
    "test": "node scripts/generate-version.mjs && vitest run",
    "test:integration": "RUN_TINFOIL_INTEGRATION=true npm test",
    "test:bun": "node scripts/generate-version.mjs && bun test --timeout 30000 ./test/surface.bun.ts ./test/tls.bun.ts ./test/ws.bun.ts",
    "test:bun:integration": "node scripts/generate-version.mjs && RUN_TINFOIL_INTEGRATION=true bun test --timeout 180000 ./test/integration.bun.ts",
    "test:browser": "vitest run --config vite.config.browser.ts",
    "test:browser:integration": "node scripts/generate-version.mjs && RUN_TINFOIL_INTEGRATION=true vitest run --config vite.config.browser.integration.ts",
    "lint": "eslint src/**/*.ts",
    "check:es2020": "test -n \"$(find dist -name '*.js')\" && find dist -name '*.js' -exec acorn --ecma2020 --module --silent {} +",
    "clean": "rm -rf dist",
    "prepack": "cp ../../README.md README.md",
    "postpack": "rm README.md",
    "prepublishOnly": "npm run build",
    "check:types": "node scripts/generate-version.mjs && tsc -p tsconfig.test.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinfoilsh/tinfoil-js.git"
  },
  "keywords": [
    "openai",
    "security",
    "AI",
    "tinfoil"
  ],
  "author": "Tinfoil",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "dependencies": {
    "@tinfoilsh/verifier": "2.0.0-rc.1",
    "@types/ws": "^8.18.1",
    "ehbp": "^0.5.0",
    "openai": "^7.35.0",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.7",
    "ai": "^6.0.168 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/openai-compatible": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.7",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "ai": "^7.0.19",
    "dotenv": "^17.4.2",
    "eslint": "^10.6.0",
    "playwright": "^1.61.1",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.12"
  }
}
